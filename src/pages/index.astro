---
import Base from '../layouts/Base.astro';
import CtaButtons from '../components/CtaButtons.astro';
import CtaBand from '../components/CtaBand.astro';
import ServiceCard from '../components/ServiceCard.astro';
import FaqList from '../components/FaqList.astro';
import Icon from '../components/Icon.astro';
import { Image } from 'astro:assets';
import heroImg from '../assets/hero.jpg';
import { site } from '../data/site';
import { fotoDoServico } from '../data/fotos';
import { servicos } from '../data/servicos';
import { cidades, cidadePath } from '../data/cidades';
import { faqSchema } from '../data/schema';
import { getCollection } from 'astro:content';

const faq = [
  {
    q: 'A desentupidora atende 24 horas mesmo?',
    a: 'Sim. Atendemos 24 horas por dia, 7 dias por semana, incluindo fins de semana e feriados, em Belo Horizonte, Contagem e Betim.',
  },
  {
    q: 'Em quanto tempo vocês chegam?',
    a: `Chegamos em até ${site.arrivalMinutes} minutos nas cidades atendidas.`,
  },
  {
    q: 'Precisa quebrar piso ou parede para desentupir?',
    a: 'Na grande maioria dos casos, não. Usamos máquinas que alcançam a obstrução por dentro do cano. Só indicamos abrir quando o cano está quebrado, e sempre com o seu aceite antes.',
  },
  {
    q: 'O desentupimento tem garantia?',
    a: 'Sim. Todos os serviços da Desentupidora Fortex têm garantia.',
  },
  {
    q: 'Vocês fazem outros serviços de encanador?',
    a: 'Não. A Desentupidora Fortex trabalha só com desentupimento: pia, vaso sanitário, ralo, esgoto e cano. É nisso que somos especialistas.',
  },
  {
    q: 'Como chamo a desentupidora?',
    a: 'É só chamar no WhatsApp ou ligar. Conte o que entupiu e, se puder, mande uma foto ou um vídeo. A equipe já sai com o equipamento certo.',
  },
];

const fotoEquipe = fotoDoServico('desentupimento-de-vaso-sanitario');

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.data.getTime() - a.data.data.getTime())
  .slice(0, 3);
---

<Base
  title="Desentupidora 24 Horas em BH, Contagem e Betim | Desentupidora Fortex"
  description={site.description}
  schema={[faqSchema(faq)]}
>
  <section class="hero hero-home">
    <Image
      class="hero-bg"
      src={heroImg}
      alt=""
      widths={[480, 800, 1200, 1440]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="container hero-center">
      <span class="eyebrow">Desentupidora em BH · Contagem · Betim</span>
      <h1>Desentupidora 24 horas em BH: <em>chegamos em até {site.arrivalMinutes} minutos</em></h1>
      <p class="hero-lead">Pia, vaso, ralo, esgoto ou cano entupido? Desentupimos hoje, a qualquer hora, sem quebra-quebra e com garantia.</p>
      <CtaButtons />
      <ul class="hero-badges">
        <li><Icon name="clock" size={22} /> <span>Atendimento 24h</span></li>
        <li><Icon name="bolt" size={22} /> <span>Chegada em até {site.arrivalMinutes} min</span></li>
        <li><Icon name="shield" size={22} /> <span>Serviço com garantia</span></li>
      </ul>
    </div>
  </section>

  <section class="trust" aria-label="Diferenciais">
    <div class="container trust-grid">
      <div class="trust-item"><Icon name="clock" size={34} /><div><strong>24 horas</strong><span>Todos os dias, inclusive feriados</span></div></div>
      <div class="trust-item"><Icon name="bolt" size={34} /><div><strong>{site.arrivalMinutes} minutos</strong><span>Tempo de chegada</span></div></div>
      <div class="trust-item"><Icon name="shield" size={34} /><div><strong>Garantia</strong><span>Em todos os serviços</span></div></div>
      <div class="trust-item"><Icon name="pin" size={34} /><div><strong>Grande BH</strong><span>BH, Contagem e Betim</span></div></div>
    </div>
  </section>

  <section class="section section-soft" id="servicos">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Nossos serviços</span>
        <h2>Só desentupimento, do jeito certo</h2>
        <p>Somos especialistas em uma coisa: fazer a água voltar a descer. Em casa, apartamento, condomínio ou comércio.</p>
      </div>
      <div class="services-grid">
        {servicos.map((s) => <ServiceCard servico={s} />)}
      </div>
    </div>
  </section>

  <section class="section section-dark">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Como funciona</span>
        <h2>Do chamado ao cano livre</h2>
        <p>Sem enrolação: você chama, a gente chega e desentope.</p>
      </div>
      <div class="steps">
        <div class="step-card">
          <h3>Chame no WhatsApp ou ligue</h3>
          <p>Conte o que entupiu. Se puder, mande uma foto ou um vídeo do problema.</p>
        </div>
        <div class="step-card">
          <h3>Chegamos em até {site.arrivalMinutes} minutos</h3>
          <p>Assim que você chama, a equipe sai com o equipamento certo para o seu tipo de entupimento.</p>
        </div>
        <div class="step-card">
          <h3>Desentupido e testado</h3>
          <p>Desentupimos, testamos o escoamento na sua frente e deixamos o local limpo. Com garantia.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container about-grid">
      {
        fotoEquipe && (
          <div class="about-photo">
            <Image src={fotoEquipe.src} alt={fotoEquipe.alt} widths={[400, 512]} sizes="(max-width: 900px) 100vw, 460px" />
          </div>
        )
      }
      <div>
      <div class="section-head">
        <span class="eyebrow">Por que a Desentupidora Fortex</span>
        <h2>Desentupidora de confiança, a qualquer hora</h2>
        <p>Equipe equipada para resolver desde a pia da cozinha até a rede de esgoto do condomínio.</p>
      </div>
      <div class="features">
        <div class="feature">
          <Icon name="clock" size={30} />
          <div><h3>Plantão 24 horas</h3><p>Entupimento não espera horário comercial. Atendemos de madrugada, fins de semana e feriados.</p></div>
        </div>
        <div class="feature">
          <Icon name="bolt" size={30} />
          <div><h3>Chegamos em {site.arrivalMinutes} minutos</h3><p>Equipes circulando por BH, Contagem e Betim para chegar rápido onde você estiver.</p></div>
        </div>
        <div class="feature">
          <Icon name="pipe" size={30} />
          <div><h3>Sem quebra-quebra</h3><p>Máquinas de cabo rotativo e de pressão desentopem por dentro do cano, sem quebrar piso nem parede na maioria dos casos.</p></div>
        </div>
        <div class="feature">
          <Icon name="shield" size={30} />
          <div><h3>Garantia no serviço</h3><p>Todo desentupimento sai com garantia. Se voltar a entupir, voltamos para resolver.</p></div>
        </div>
      </div>
      </div>
    </div>
  </section>

  <CtaBand />

  <section class="section section-soft" id="cidades">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Cidades atendidas</span>
        <h2>Desentupidora perto de você</h2>
        <p>Atendemos 24 horas em Belo Horizonte, Contagem e Betim.</p>
      </div>
      <div class="cidades-grid">
        {
          cidades.map((c) => (
            <a class="cidade-card" href={cidadePath(c)}>
              <Icon name="pin" size={30} />
              <h3>Desentupidora em {c.nome}</h3>
              <p>{c.resumo}</p>
              <span class="service-more">Ver página <Icon name="arrow" size={16} /></span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {
    posts.length > 0 && (
      <section class="section">
        <div class="container">
          <div class="section-head">
            <span class="eyebrow">Blog</span>
            <h2>Dicas sobre entupimento</h2>
          </div>
          <div class="posts">
            {posts.map((p) => (
              <a class="post-card" href={`/blog/${p.id}/`}>
                <time datetime={p.data.data.toISOString()}>{p.data.data.toLocaleDateString('pt-BR')}</time>
                <h3>{p.data.titulo}</h3>
                <p>{p.data.descricao}</p>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section section-soft">
    <div class="container" style="max-width: 860px">
      <div class="section-head">
        <span class="eyebrow">Dúvidas frequentes</span>
        <h2>Perguntas frequentes</h2>
      </div>
      <FaqList items={faq} />
    </div>
  </section>

  <CtaBand title="Entupiu agora? Chame a Fortex." />
</Base>
